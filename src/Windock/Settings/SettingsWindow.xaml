<Window x:Class="Windock.Settings.SettingsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windock Settings" Width="800" Height="580" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Settings.Background}"
        Icon="/Assets/windock.ico">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Settings.Sidebar}" BorderBrush="{StaticResource Settings.Line}"
                BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="WindockModeButton" Content="Windock mode" Padding="20,9" Margin="0,0,8,0" Click="OnWindockMode" />
                    <Button x:Name="WindowsModeButton" Content="Windows mode" Padding="20,9" Click="OnWindowsMode" />
                </StackPanel>
                <TextBlock x:Name="ModeHint" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="18,0,0,0" />
            </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="Nav" Grid.Column="0" BorderThickness="0,0,1,0" Padding="8,16" SelectionChanged="OnNavigate">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource Settings.Text}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="6" Padding="12,8" Margin="0,1" Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Settings.ControlHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Settings.Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBoxItem Content="Appearance" />
                <ListBoxItem Content="Theme" />
                <ListBoxItem Content="Status area" />
                <ListBoxItem Content="Dynamic Island" />
                <ListBoxItem Content="Behavior" />
                <ListBoxItem Content="Dock items" />
                <ListBoxItem Content="Launcher" />
                <ListBoxItem Content="Alt+Tab" />
                <ListBoxItem Content="Safety" />
                <ListBoxItem Content="About" />
            </ListBox>

            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Settings.Line}" BorderThickness="0,1,0,0" Padding="28,9">
                    <TextBlock x:Name="Status" Style="{StaticResource Hint}"
                               Text="Every change is applied to the dock right away and saved automatically." />
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ContentControl x:Name="Page" Margin="28,24" />
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
