<Window x:Class="Windock.Settings.SettingsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pengaturan Windock" Width="760" Height="520" MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Settings.Background}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox x:Name="Nav" Grid.Column="0" BorderThickness="0,0,1,0" Padding="8,16" SelectionChanged="OnNavigate">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource Settings.Text}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" CornerRadius="6" Padding="12,8" Margin="0,1" Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Settings.ControlHover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Settings.Accent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBoxItem Content="Tampilan" />
            <ListBoxItem Content="Perilaku" />
            <ListBoxItem Content="Isi Dock" />
            <ListBoxItem Content="Pengaman" />
            <ListBoxItem Content="Tentang" />
        </ListBox>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <ContentControl x:Name="Page" Margin="28,24" />
        </ScrollViewer>
    </Grid>
</Window>
