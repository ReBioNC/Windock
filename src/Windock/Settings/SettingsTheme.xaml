<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Settings.Background" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="Settings.Sidebar" Color="#FF262626" />
    <SolidColorBrush x:Key="Settings.Control" Color="#FF333333" />
    <SolidColorBrush x:Key="Settings.ControlHover" Color="#FF3D3D3D" />
    <SolidColorBrush x:Key="Settings.Line" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="Settings.Text" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="Settings.Muted" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="Settings.Accent" Color="#FF2F6FE4" />
    <SolidColorBrush x:Key="Settings.Error" Color="#FFFF6B6B" />

    <Style TargetType="TextBlock" x:Key="PageTitle">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Settings.Text}" />
        <Setter Property="Margin" Value="0,0,0,18" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Label">
        <Setter Property="Foreground" Value="{StaticResource Settings.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Hint">
        <Setter Property="Foreground" Value="{StaticResource Settings.Muted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Settings.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Settings.Text}" />
        <Setter Property="Margin" Value="0,0,18,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="TickFrequency" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Settings.Text}" />
        <Setter Property="Background" Value="{StaticResource Settings.Control}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Settings.ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Settings.Text}" />
        <Setter Property="Background" Value="{StaticResource Settings.Control}" />
        <Setter Property="BorderBrush" Value="{StaticResource Settings.Line}" />
        <Setter Property="CaretBrush" Value="{StaticResource Settings.Text}" />
        <Setter Property="Padding" Value="8,5" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource Settings.Sidebar}" />
        <Setter Property="BorderBrush" Value="{StaticResource Settings.Line}" />
        <Setter Property="Foreground" Value="{StaticResource Settings.Text}" />
    </Style>

    <!-- One settings row: label on the left, control on the right. -->
    <Style TargetType="Grid" x:Key="Row">
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
</ResourceDictionary>
