<UserControl x:Class="Windock.Settings.Pages.SafetyPage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Safety" Style="{StaticResource PageTitle}" />

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="240" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="Emergency shortcut" Style="{StaticResource Label}" />
            <TextBox x:Name="Recorder" Grid.Column="1" IsReadOnly="True" IsReadOnlyCaretVisible="False" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center"
                       Text="Click the box, then press the new combination." />
        </Grid>
        <TextBlock x:Name="RecorderMessage" Style="{StaticResource Hint}" Margin="170,-6,0,14" />

        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10"
                   Text="The emergency shortcut quits Windock at once and gives the Windows taskbar back exactly as it was." />

        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="Restore the taskbar now" Click="OnRestoreTaskbar" Margin="0,0,8,0" />
            <Button Content="Open data folder" Click="OnOpenData" />
        </StackPanel>
    </StackPanel>
</UserControl>
