<UserControl x:Class="Windock.Settings.Pages.StatusPage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Area status" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                   Text="Tombol-tombol di ujung kanan dock, pengganti bagian kanan taskbar Windows." />

        <CheckBox x:Name="Enabled" Content="Tampilkan area status di dock" FontWeight="SemiBold" />

        <StackPanel x:Name="Options" Margin="0,8,0,0">
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Tombol" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1">
                    <CheckBox x:Name="Tray" Content="^ Ikon tersembunyi (tray Windows)" Margin="0,0,0,8" />
                    <CheckBox x:Name="Wifi" Content="Jaringan (Wi-Fi / kabel)" Margin="0,0,0,8" />
                    <CheckBox x:Name="Volume" Content="Volume" Margin="0,0,0,8" />
                    <CheckBox x:Name="Battery" Content="Baterai" Margin="0,0,0,8" />
                    <CheckBox x:Name="LanguageBox" Content="Bahasa input (EN, ID, …)" Margin="0,0,0,8" />
                    <CheckBox x:Name="Clock" Content="Jam" Margin="0,0,0,8" />
                    <CheckBox x:Name="Notifications" Content="Pusat notifikasi" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Tray: Windock memunculkan taskbar asli sebentar dengan ikon tersembunyinya, lalu menyembunyikannya lagi. Volume: gulir mouse untuk mengatur, klik tengah untuk bisukan." />
                </StackPanel>
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Jam" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="Clock24" GroupName="ClockFormat" Content="24 jam (13:45)" Margin="0,0,16,0" />
                        <RadioButton x:Name="Clock12" GroupName="ClockFormat" Content="12 jam (1:45 PM)" />
                    </StackPanel>
                    <CheckBox x:Name="ShowDate" Content="Tampilkan tanggal di bawah jam" Margin="0,0,0,8" />
                    <CheckBox x:Name="ShowSeconds" Content="Tampilkan detik" />
                </StackPanel>
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Baterai" Style="{StaticResource Label}" />
                <CheckBox x:Name="BatteryPercent" Grid.Column="1" Content="Tampilkan persen di samping ikon" />
            </Grid>
        </StackPanel>

        <Button Content="Kembalikan ke default" HorizontalAlignment="Right" Margin="0,12,0,0" Click="OnReset" />
    </StackPanel>
</UserControl>
