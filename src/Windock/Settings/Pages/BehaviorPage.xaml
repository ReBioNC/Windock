<UserControl x:Class="Windock.Settings.Pages.BehaviorPage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Perilaku" Style="{StaticResource PageTitle}" />

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="Taskbar Windows" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <StackPanel Grid.Column="1">
                <RadioButton x:Name="Hidden" GroupName="Taskbar" Content="Sembunyikan total" Margin="0,0,0,8" />
                <RadioButton x:Name="AutoHide" GroupName="Taskbar" Content="Auto-hide" Margin="0,0,0,8" />
                <RadioButton x:Name="Visible" GroupName="Taskbar" Content="Biarkan tampil" Margin="0,0,0,8" />
                <TextBlock x:Name="HiddenHint" Style="{StaticResource Hint}" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="Sembunyikan dock" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <StackPanel Grid.Column="1">
                <RadioButton x:Name="HideNever" GroupName="AutoHide" Content="Tidak pernah" Margin="0,0,0,8" />
                <RadioButton x:Name="HideWhenCovered" GroupName="AutoHide" Content="Saat jendela menutupi dock (mis. di-maximize)" Margin="0,0,0,8" />
                <RadioButton x:Name="HideAlways" GroupName="AutoHide" Content="Selalu (seperti Mac)" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Text="Saat tersembunyi, sentuhkan kursor ke tepi bawah layar untuk memunculkan dock. Jendela yang di-maximize memakai layar penuh." />
            </StackPanel>
        </Grid>

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="Animasi" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <StackPanel Grid.Column="1">
                <CheckBox x:Name="Bounce" Content="Ikon memantul saat aplikasi dibuka" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Text="Berhenti saat jendelanya muncul (paling lama 10 detik). Mati otomatis jika animasi Windows dimatikan." />
            </StackPanel>
        </Grid>

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="Ikon minta perhatian" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <StackPanel Grid.Column="1">
                <RadioButton x:Name="AttentionBounce" GroupName="Attention" Content="Memantul" Margin="0,0,0,8" />
                <RadioButton x:Name="AttentionDot" GroupName="Attention" Content="Titik merah" Margin="0,0,0,8" />
                <RadioButton x:Name="AttentionOff" GroupName="Attention" Content="Mati" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <RadioButton x:Name="RepeatUntilOpened" GroupName="AttentionRepeat" Content="Sampai dibuka" Margin="0,0,16,0" />
                    <RadioButton x:Name="RepeatOnce" GroupName="AttentionRepeat" Content="Sekali" />
                </StackPanel>
                <CheckBox x:Name="FromNotifications" Content="Juga dari notifikasi Windows (WhatsApp, dll.)" Margin="0,10,0,0" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                           Text="Saat aplikasi berkedip minta dilihat atau mengirim notifikasi (mis. pesan masuk), ikonnya di dock ditandai sampai aplikasinya dibuka. Windock hanya melihat aplikasi mana yang punya notifikasi baru, bukan isinya." />
            </StackPanel>
        </Grid>

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="Saat Windows nyala" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <StackPanel Grid.Column="1">
                <CheckBox x:Name="Startup" Content="Jalankan Windock otomatis" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Text="Disimpan di daftar startup akun kamu saja (bisa dilihat di Task Manager &gt; Startup)." />
            </StackPanel>
        </Grid>

        <Button Content="Kembalikan ke default" HorizontalAlignment="Right" Margin="0,18,0,0" Click="OnReset" />
    </StackPanel>
</UserControl>
