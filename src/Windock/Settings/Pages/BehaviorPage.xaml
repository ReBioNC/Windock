<UserControl x:Class="Windock.Settings.Pages.BehaviorPage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Behavior" Style="{StaticResource PageTitle}" />

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="Windows taskbar" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <StackPanel Grid.Column="1">
                <RadioButton x:Name="Hidden" GroupName="Taskbar" Content="Hide completely" Margin="0,0,0,8" />
                <RadioButton x:Name="AutoHide" GroupName="Taskbar" Content="Auto-hide" Margin="0,0,0,8" />
                <RadioButton x:Name="Visible" GroupName="Taskbar" Content="Leave it visible" Margin="0,0,0,8" />
                <TextBlock x:Name="HiddenHint" Style="{StaticResource Hint}" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="Hide the dock" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <StackPanel Grid.Column="1">
                <RadioButton x:Name="HideNever" GroupName="AutoHide" Content="Never" Margin="0,0,0,8" />
                <RadioButton x:Name="HideWhenCovered" GroupName="AutoHide" Content="When a window covers it (for example, maximized)" Margin="0,0,0,8" />
                <RadioButton x:Name="HideAlways" GroupName="AutoHide" Content="Always (like a Mac)" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Text="While hidden, touch the bottom edge of the screen to bring the dock up. Maximized windows use the whole screen." />
            </StackPanel>
        </Grid>

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="Animation" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <StackPanel Grid.Column="1">
                <CheckBox x:Name="Bounce" Content="Bounce icons while apps open" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Text="Stops when the window appears (10 seconds at most). Turned off automatically when Windows animations are off." />
            </StackPanel>
        </Grid>

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="Icons asking for attention" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <StackPanel Grid.Column="1">
                <RadioButton x:Name="AttentionBounce" GroupName="Attention" Content="Bounce" Margin="0,0,0,8" />
                <RadioButton x:Name="AttentionDot" GroupName="Attention" Content="Red dot" Margin="0,0,0,8" />
                <RadioButton x:Name="AttentionOff" GroupName="Attention" Content="Off" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <RadioButton x:Name="RepeatUntilOpened" GroupName="AttentionRepeat" Content="Until opened" Margin="0,0,16,0" />
                    <RadioButton x:Name="RepeatOnce" GroupName="AttentionRepeat" Content="Once" />
                </StackPanel>
                <CheckBox x:Name="FromNotifications" Content="Also from Windows notifications (WhatsApp and others)" Margin="0,10,0,0" />
                <CheckBox x:Name="BadgeCounts" Content="Show the unread count in the red dot" Margin="22,8,0,0" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                           Text="When an app flashes for attention or sends a notification (a new message, for example), its dock icon is marked until you open it. Windock only sees which app has new notifications, never their content." />
            </StackPanel>
        </Grid>

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="When Windows starts" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
            <StackPanel Grid.Column="1">
                <CheckBox x:Name="Startup" Content="Start Windock automatically" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Text="Stored in your account's startup list only (visible in Task Manager &gt; Startup)." />
            </StackPanel>
        </Grid>

        <Button Content="Reset to defaults" HorizontalAlignment="Right" Margin="0,18,0,0" Click="OnReset" />
    </StackPanel>
</UserControl>
