<UserControl x:Class="Windock.Settings.Pages.AppearancePage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Tampilan" Style="{StaticResource PageTitle}" />

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
            <TextBlock Text="Ukuran ikon" Style="{StaticResource Label}" />
            <Slider x:Name="IconSize" Grid.Column="1" Minimum="32" Maximum="96" />
            <TextBlock Grid.Column="2" Style="{StaticResource Label}" HorizontalAlignment="Right" Text="{Binding Value, ElementName=IconSize}" />
        </Grid>

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="Magnification" Style="{StaticResource Label}" />
            <CheckBox x:Name="Magnification" Grid.Column="1" Content="Ikon membesar saat kursor lewat" />
        </Grid>

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
            <TextBlock Text="Ukuran maksimal" Style="{StaticResource Label}" />
            <Slider x:Name="MagnifiedSize" Grid.Column="1" Minimum="32" Maximum="128" />
            <TextBlock Grid.Column="2" Style="{StaticResource Label}" HorizontalAlignment="Right" Text="{Binding Value, ElementName=MagnifiedSize}" />
        </Grid>

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
            <TextBlock Text="Opacity latar" Style="{StaticResource Label}" />
            <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0" Maximum="100" />
            <TextBlock Grid.Column="2" Style="{StaticResource Label}" HorizontalAlignment="Right" Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0}%}" />
        </Grid>

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="Blur" Style="{StaticResource Label}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton x:Name="BlurOff" GroupName="Blur" Content="Mati" />
                <RadioButton x:Name="BlurStandard" GroupName="Blur" Content="Blur standar" />
            </StackPanel>
        </Grid>

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="Titik penanda" Style="{StaticResource Label}" />
            <CheckBox x:Name="Indicators" Grid.Column="1" Content="Tandai aplikasi yang sedang jalan" />
        </Grid>

        <Button Content="Kembalikan ke default" HorizontalAlignment="Right" Margin="0,12,0,0" Click="OnReset" />
    </StackPanel>
</UserControl>
