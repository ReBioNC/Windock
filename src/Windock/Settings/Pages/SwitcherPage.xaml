<UserControl x:Class="Windock.Settings.Pages.SwitcherPage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Alt+Tab" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                   Text="Use Windock's window switcher for Alt+Tab: live previews, grouped by app, and type to search. Turn it off to go back to the Windows Alt+Tab." />

        <CheckBox x:Name="Enabled" Content="Replace Alt+Tab with Windock's switcher" FontWeight="SemiBold" />

        <StackPanel x:Name="Options" Margin="0,8,0,0">
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Order" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1">
                    <RadioButton x:Name="Grouped" GroupName="Order" Content="Group by app" Margin="0,0,0,8" />
                    <RadioButton x:Name="Flat" GroupName="Order" Content="All windows, most recently used first" />
                </StackPanel>
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Card size" Style="{StaticResource Label}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton x:Name="Small" GroupName="Size" Content="Small" Margin="0,0,16,0" />
                    <RadioButton x:Name="Medium" GroupName="Size" Content="Medium" Margin="0,0,16,0" />
                    <RadioButton x:Name="Large" GroupName="Size" Content="Large" />
                </StackPanel>
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Display" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1">
                    <CheckBox x:Name="Previews" Content="Live previews of window contents (turn off for icons only, the lightest)" Margin="0,0,0,8" />
                    <CheckBox x:Name="CurrentScreen" Content="Only windows on the screen under the pointer" />
                    <TextBlock Style="{StaticResource Hint}" Margin="22,4,0,0" Text="Handy with a laptop plus a monitor: Alt+Tab on the monitor lists only the windows on that monitor." />
                </StackPanel>
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Fullscreen games" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1">
                    <CheckBox x:Name="FullscreenFallback" Content="Use the Windows Alt+Tab while an exclusive fullscreen game is in front" />
                    <TextBlock Style="{StaticResource Hint}" Margin="22,4,0,0" Text="Exclusive fullscreen games (that take over the screen) cannot have other windows on top, so the built-in Alt+Tab is safer there. Borderless fullscreen games keep Windock's switcher." />
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                       Text="How to use: hold Alt and press Tab (Shift+Tab or the arrow keys go back). While holding Alt, type to search, Del closes the selected window, Esc cancels. Release Alt to switch." />
        </StackPanel>

        <Button Content="Reset to defaults" HorizontalAlignment="Right" Margin="0,12,0,0" Click="OnReset" />
    </StackPanel>
</UserControl>
