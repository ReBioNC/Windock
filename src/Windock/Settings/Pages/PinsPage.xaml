<UserControl x:Class="Windock.Settings.Pages.PinsPage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Isi Dock" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                   Text="Aplikasi yang selalu ada di dock. Seret untuk mengatur urutan." />

        <ListBox x:Name="List" Height="250" AllowDrop="True" SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4,3">
                        <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Settings.Text}" />
                            <TextBlock Text="{Binding Path}" Foreground="{StaticResource Settings.Muted}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Tambah…" Click="OnAdd" Margin="0,0,8,0" />
            <Button x:Name="RemoveButton" Content="Hapus" Click="OnRemove" Margin="0,0,8,0" />
            <Button Content="Kembalikan pin default" Click="OnResetPins" />
        </StackPanel>
        <TextBlock x:Name="Message" Style="{StaticResource Hint}" Foreground="{StaticResource Settings.Error}" Margin="0,10,0,0" />

        <TextBlock Text="Disembunyikan" Style="{StaticResource Label}" Margin="0,22,0,4" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                   Text="Aplikasi yang sedang jalan tapi tidak ditampilkan di dock (klik kanan ikon &gt; Jangan tampilkan di dock)." />
        <ListBox x:Name="HiddenList" Height="96" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,3">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Settings.Text}" />
                        <TextBlock Text="{Binding AppId}" Foreground="{StaticResource Settings.Muted}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="HiddenEmpty" Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Belum ada aplikasi yang disembunyikan." />
        <Button x:Name="ShowAgainButton" Content="Tampilkan lagi" Click="OnShowAgain" HorizontalAlignment="Left" Margin="0,10,0,0" />

        <TextBlock Text="Recycle Bin" Style="{StaticResource Label}" Margin="0,22,0,6" />
        <CheckBox x:Name="ShowBin" Content="Tampilkan Recycle Bin di ujung dock" />
        <CheckBox x:Name="ConfirmTrash" Content="Tanya dulu sebelum memindahkan file ke Recycle Bin" Margin="0,8,0,0" />
        <TextBlock Style="{StaticResource Hint}" Margin="22,6,0,0"
                   Text="Seret file ke ikon Recycle Bin untuk membuangnya. File tetap bisa dipulihkan dari Recycle Bin." />

        <CheckBox x:Name="ExplorerMenu" Margin="0,22,0,0"
                  Content="Tampilkan &quot;Pin ke Windock&quot; di menu klik kanan Explorer dan Desktop" />
        <TextBlock Style="{StaticResource Hint}" Margin="22,6,0,0"
                   Text="Kamu juga bisa menyeret program atau shortcut ke dock, menyeret ikon untuk mengatur urutan, atau menyeretnya keluar dari dock untuk menghapus." />
    </StackPanel>
</UserControl>
