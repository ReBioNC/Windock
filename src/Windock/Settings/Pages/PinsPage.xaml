<UserControl x:Class="Windock.Settings.Pages.PinsPage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Dock items" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                   Text="Apps that always stay in the dock. Drag to reorder." />

        <ListBox x:Name="List" Height="250" AllowDrop="True" SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4,3">
                        <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Settings.Text}" />
                            <TextBlock Text="{Binding Path}" Foreground="{StaticResource Settings.Muted}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Add…" Click="OnAdd" Margin="0,0,8,0" />
            <Button x:Name="RemoveButton" Content="Remove" Click="OnRemove" Margin="0,0,8,0" />
            <Button Content="Reset pins" Click="OnResetPins" />
        </StackPanel>
        <TextBlock x:Name="Message" Style="{StaticResource Hint}" Foreground="{StaticResource Settings.Error}" Margin="0,10,0,0" />

        <TextBlock Text="Hidden" Style="{StaticResource Label}" Margin="0,22,0,4" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                   Text="Running apps that are not shown in the dock (right-click an icon &gt; Don't show in dock)." />
        <ListBox x:Name="HiddenList" Height="96" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,3">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Settings.Text}" />
                        <TextBlock Text="{Binding AppId}" Foreground="{StaticResource Settings.Muted}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="HiddenEmpty" Style="{StaticResource Hint}" Margin="0,6,0,0" Text="No hidden apps yet." />
        <Button x:Name="ShowAgainButton" Content="Show again" Click="OnShowAgain" HorizontalAlignment="Left" Margin="0,10,0,0" />

        <TextBlock Text="Recycle Bin" Style="{StaticResource Label}" Margin="0,22,0,6" />
        <CheckBox x:Name="ShowBin" Content="Show the Recycle Bin at the end of the dock" />
        <CheckBox x:Name="ConfirmTrash" Content="Ask before moving files to the Recycle Bin" Margin="0,8,0,0" />
        <TextBlock Style="{StaticResource Hint}" Margin="22,6,0,0"
                   Text="Drag files onto the Recycle Bin icon to throw them away. They can still be restored from the Recycle Bin." />

        <CheckBox x:Name="ExplorerMenu" Margin="0,22,0,0"
                  Content="Show &quot;Pin to Windock&quot; in the Explorer and Desktop right-click menu" />
        <TextBlock Style="{StaticResource Hint}" Margin="22,6,0,0"
                   Text="You can also drag programs or shortcuts onto the dock, drag icons to reorder them, or drag them out of the dock to remove them." />
    </StackPanel>
</UserControl>
