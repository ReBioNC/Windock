<UserControl x:Class="Windock.Settings.Pages.IslandPage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Dynamic Island" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                   Text="A pill at the top centre of the screen with the time, what's playing, and short pop-ups for volume, brightness, battery and devices. Point at it to open it." />

        <CheckBox x:Name="Enabled" Content="Show the Dynamic Island" FontWeight="SemiBold" />

        <StackPanel x:Name="Options" Margin="0,8,0,0">
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Visibility" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1">
                    <RadioButton x:Name="AutoHide" GroupName="Visibility" Content="Hide when a window covers it" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,8"
                               Text="E.g. a maximized browser: the island slides up so its tabs stay clickable. It comes back when you touch the top edge above it, when something happens (volume, charger, device, new song), or on the desktop." />
                    <RadioButton x:Name="Always" GroupName="Visibility" Content="Always show (on top of every window)" />
                    <TextBlock Style="{StaticResource Hint}" Margin="22,4,0,0" Text="It always hides while a fullscreen game or video is in front." />
                </StackPanel>
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="In the island" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1">
                    <CheckBox x:Name="Clock" Content="Clock" Margin="0,0,0,8" />
                    <CheckBox x:Name="Date" Content="Day and date" Margin="0,0,0,8" />
                    <CheckBox x:Name="Battery" Content="Battery" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Items shown here leave the dock's status area. The clock format (24-hour, seconds) and the battery percentage follow the Status area page." />
                </StackPanel>
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Activity" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1">
                    <CheckBox x:Name="Media" Content="Now playing (Spotify, browsers, media players)" />
                    <CheckBox x:Name="Lyrics" Content="Synced lyrics on the Music page" Margin="22,8,0,0" />
                    <TextBlock Style="{StaticResource Hint}" Margin="44,2,0,0" TextWrapping="Wrap"
                               Text="From LRCLIB (free, no account). Only the song title, artist, album and length are sent. The speech-bubble button on the Music page shows or hides them." />
                    <TextBlock Style="{StaticResource Hint}" Margin="22,4,0,0" Text="Cover art and moving bars in the pill, and a Music page in the open island (slide right from the clock) with the title, progress and play/pause, previous and next." />
                </StackPanel>
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="More panels" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1">
                    <CheckBox x:Name="DevicesPanel" Content="Devices (keyboards, mice, displays, audio, Bluetooth)" Margin="0,0,0,8" />
                    <CheckBox x:Name="WeatherPanel" Content="Weather (from Open-Meteo, needs internet)" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="With the island open, click an icon in its tab bar, swipe left or right with two fingers on the touchpad, or scroll to switch panels. The dots at the bottom show where you are. Bluetooth devices show their battery when they report it." />
                </StackPanel>
            </Grid>

            <Grid x:Name="WeatherOptions" Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Weather city" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,4,0,0" />
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="City" Width="220" />
                        <RadioButton x:Name="Celsius" GroupName="Unit" Content="&#x00B0;C" Margin="16,0,12,0" VerticalAlignment="Center" />
                        <RadioButton x:Name="Fahrenheit" GroupName="Unit" Content="&#x00B0;F" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="PlaceHint" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Pop-ups" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1">
                    <CheckBox x:Name="Volume" Content="Volume changes" Margin="0,0,0,8" />
                    <CheckBox x:Name="Brightness" Content="Brightness changes (laptop screen)" Margin="0,0,0,8" />
                    <CheckBox x:Name="PowerEvents" Content="Charger plugged in or out, battery low" Margin="0,0,0,8" />
                    <CheckBox x:Name="Devices" Content="Keyboard, mouse or monitor connected or disconnected" />
                </StackPanel>
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
                <TextBlock Text="Pop-up duration" Style="{StaticResource Label}" />
                <Slider x:Name="EventSeconds" Grid.Column="1" Minimum="1" Maximum="5" IsSnapToTickEnabled="True" TickFrequency="1" />
                <TextBlock Grid.Column="2" Style="{StaticResource Label}" HorizontalAlignment="Right" Text="{Binding Value, ElementName=EventSeconds, StringFormat={}{0} s}" />
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Pointer" Style="{StaticResource Label}" />
                <StackPanel Grid.Column="1">
                    <CheckBox x:Name="ExpandOnHover" Content="Open the island when the pointer is over it" Margin="0,0,0,8" />
                    <CheckBox x:Name="Mascot" Content="Show Wado the whale (dances to music, smiles when you plug something in, sleeps at night)" />
                </StackPanel>
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Size" Style="{StaticResource Label}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton x:Name="Small" GroupName="Size" Content="Small" Margin="0,0,16,0" />
                    <RadioButton x:Name="Medium" GroupName="Size" Content="Medium" Margin="0,0,16,0" />
                    <RadioButton x:Name="Large" GroupName="Size" Content="Large" />
                </StackPanel>
            </Grid>

            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="Color" Style="{StaticResource Label}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton x:Name="Black" GroupName="Color" Content="Black" Margin="0,0,16,0" />
                    <RadioButton x:Name="DockColor" GroupName="Color" Content="Dock color (Theme page)" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <Button Content="Reset to defaults" HorizontalAlignment="Right" Margin="0,12,0,0" Click="OnReset" />
    </StackPanel>
</UserControl>
