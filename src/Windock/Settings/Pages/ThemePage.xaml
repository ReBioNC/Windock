<UserControl x:Class="Windock.Settings.Pages.ThemePage" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Theme" Style="{StaticResource PageTitle}" />

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="Dock color" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,6,0,0" />
            <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <WrapPanel x:Name="PlateSwatches" />
                    <TextBox x:Name="PlateHex" Width="90" Margin="8,0,0,0" VerticalContentAlignment="Center" />
                </StackPanel>
                <CheckBox x:Name="FollowWallpaper" Content="Follow the wallpaper color" Margin="0,10,0,0" />
                <TextBlock Style="{StaticResource Hint}" Margin="22,4,0,0"
                           Text="The wallpaper's average color, darkened so icons stay clear. Updates when the wallpaper changes." />
            </StackPanel>
        </Grid>

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions>
            <TextBlock Text="Corner radius" Style="{StaticResource Label}" />
            <Slider x:Name="Radius" Grid.Column="1" Minimum="0" Maximum="30" IsSnapToTickEnabled="True" TickFrequency="1" />
            <TextBlock Grid.Column="2" Style="{StaticResource Label}" HorizontalAlignment="Right" Text="{Binding Value, ElementName=Radius}" />
        </Grid>

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="Border" Style="{StaticResource Label}" />
            <CheckBox x:Name="Border" Grid.Column="1" Content="Thin line around the dock" />
        </Grid>

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="Indicator color" Style="{StaticResource Label}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <WrapPanel x:Name="DotSwatches" />
                <TextBox x:Name="DotHex" Width="90" Margin="8,0,0,0" VerticalContentAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Style="{StaticResource Row}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <TextBlock Text="Accent color" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,6,0,0" />
            <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <WrapPanel x:Name="AccentSwatches" />
                    <TextBox x:Name="AccentHex" Width="90" Margin="8,0,0,0" VerticalContentAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Used in right-click menus, highlights and this Settings window." />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="Message" Style="{StaticResource Hint}" Foreground="{StaticResource Settings.Error}" Margin="0,4,0,0" />

        <Button Content="Reset theme" HorizontalAlignment="Right" Margin="0,12,0,0" Click="OnReset" />
    </StackPanel>
</UserControl>
