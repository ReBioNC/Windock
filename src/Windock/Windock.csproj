<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\windock.ico</ApplicationIcon>
    <!-- WPF takes DPI awareness from the manifest; the WinForms analyzer (NotifyIcon only) objects. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Version>0.3.0</Version>
    <!-- Smaller idle footprint (measured: 55 MB -> 40 MB private working set). -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <AssemblyTitle>Windock</AssemblyTitle>
    <Product>Windock</Product>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\windock.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Windock.Core\Windock.Core.csproj" />
  </ItemGroup>

</Project>
