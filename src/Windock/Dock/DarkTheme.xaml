<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Windock.Surface" Color="#F02A2A2A" />
    <SolidColorBrush x:Key="Windock.SurfaceRaised" Color="#FF333333" />
    <SolidColorBrush x:Key="Windock.Border" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="Windock.Text" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="Windock.TextMuted" Color="#FF9A9A9A" />
    <SolidColorBrush x:Key="Windock.Accent" Color="#FF2F6FE4" />

    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource Windock.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource Windock.Surface}" BorderBrush="{StaticResource Windock.Border}"
                            BorderThickness="1" CornerRadius="8" Padding="5" MinWidth="200">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Windock.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="10,4,16,5">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Windock.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Windock.TextMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="6,4" Background="{StaticResource Windock.Border}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
